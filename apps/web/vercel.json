{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_MESSAGE\" in *\"[skip ci]\"*) exit 0 ;; esac; if [ \"$VERCEL_ENV\" = \"preview\" ]; then exit 0; fi; npx turbo-ignore",
  "redirects": [
    {
      "source": "/",
      "destination": "https://blode.co/react-vello",
      "has": [
        {
          "type": "host",
          "value": "react-vello.blode.co"
        }
      ],
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://blode.co/react-vello/:path*",
      "has": [
        {
          "type": "host",
          "value": "react-vello.blode.co"
        }
      ],
      "statusCode": 301
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "redirects": [
    {
      "source": "/",
      "destination": "https://blode.co/react-vello",
      "has": [{ "type": "host", "value": "react-vello.blode.co" }],
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://blode.co/react-vello/:path*",
      "has": [{ "type": "host", "value": "react-vello.blode.co" }],
      "statusCode": 301
    }
  ]
}
